# Website analytics.
#
# Umami is SELF-HOSTED and cookieless. It is completely inert unless BOTH vars
# below are set (in Vercel → Project → Settings → Environment Variables, or a
# local .env.local for testing). Nothing is sent anywhere until configured.
#
# Vercel Analytics (@vercel/analytics) is separate and needs no configuration.
NEXT_PUBLIC_UMAMI_URL=https://analytics.your-domain.example
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Vial registry automation.
#
# GITHUB_TOKEN is a fine-grained token for OpenSmell/OpenSmell-web with:
#   Issues: read and write
#   Contents: read and write
# It creates submission issues and commits approved entries to
# public/vials/registry.json. Without it, Vial submissions fall back to email
# and the /admin Vial queue stays disabled.
GITHUB_TOKEN=

# VIAL_ADMIN_TOKEN is the bearer token the /admin Vial queue sends. Generate a
# random 32+ byte value (for example: openssl rand -hex 32) and keep it out of
# the repository. The Academy password is a separate, client-side gate.
VIAL_ADMIN_TOKEN=
