# Website analytics.
#
# Umami is SELF-HOSTED and cookieless. It is completely inert unless BOTH vars
# below are set (in Vercel → Project → Settings → Environment Variables, or a
# local .env.local for testing). Nothing is sent anywhere until configured.
#
# Vercel Analytics (@vercel/analytics) is separate and needs no configuration.
NEXT_PUBLIC_UMAMI_URL=https://analytics.your-domain.example
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
